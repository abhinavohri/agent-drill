{
  "kind": "command",
  "command": [
    ".venv/bin/python",
    "run_target.py",
    "--mcp-url",
    "{mcp_url}",
    "--prompt",
    "{task}",
    "--policy-file",
    "{policy_file}",
    "--trace",
    "{trace_path}"
  ],
  "working_directory": ".",
  "inherit_environment": ["PATH", "ANTHROPIC_API_KEY"],
  "environment": {},
  "timeout_seconds": 600,
  "trace_path": "trajectory.json"
}
