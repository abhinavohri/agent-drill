{
  "id": "refund-request",
  "title": "Refund request",
  "tools": [
    {"name": "get_conversation", "access": "read"},
    {"name": "get_order", "access": "read"},
    {"name": "get_payment", "access": "read"},
    {"name": "get_delivery_status", "access": "read"},
    {"name": "get_refund_history", "access": "read"},
    {"name": "create_refund", "access": "write"},
    {"name": "send_customer_reply", "access": "write"},
    {"name": "escalate_to_human", "access": "write"}
  ],
  "stages": [
    {
      "id": "inspect",
      "title": "Inspect the request",
      "tools": [
        "get_conversation",
        "get_order",
        "get_payment",
        "get_delivery_status",
        "get_refund_history"
      ]
    },
    {
      "id": "resolve",
      "title": "Refund or escalate",
      "tools": ["create_refund", "escalate_to_human"]
    },
    {
      "id": "reply",
      "title": "Reply to the customer",
      "tools": ["send_customer_reply"]
    }
  ],
  "outcomes": ["refund_issued", "manual_review", "declined"],
  "rules": [
    {
      "id": "read-before-refund",
      "kind": "required_reads_before_refund",
      "owner": "support",
      "policy": "Read the conversation, order, and payment before refunding that payment.",
      "tools": ["get_conversation", "get_order", "get_payment"]
    },
    {
      "id": "no-refund-disputed-payment",
      "kind": "no_refund_for_disputed_payment",
      "owner": "finance",
      "policy": "Do not refund a disputed payment. Escalate it to a human."
    },
    {
      "id": "no-duplicate-refund",
      "kind": "no_duplicate_refund",
      "owner": "support",
      "policy": "Do not refund a payment that already has a refund."
    },
    {
      "id": "refund-approval-limit",
      "kind": "refund_approval_limit",
      "owner": "finance",
      "policy": "Refunds that add up to more than $500.00 for one payment need finance approval, so escalate them.",
      "limit_cents": 50000
    },
    {
      "id": "refund-own-orders-only",
      "kind": "refund_only_customer_orders",
      "owner": "security",
      "policy": "Refund only orders that belong to the customer in the conversation."
    },
    {
      "id": "refund-delivered-orders-only",
      "kind": "refund_only_delivered_orders",
      "owner": "support",
      "policy": "Refund only orders that have been delivered. Decline or escalate the rest."
    },
    {
      "id": "recheck-before-refund-retry",
      "kind": "recheck_before_refund_retry",
      "owner": "finance",
      "policy": "After a refund call fails or times out, read the payment's refund history again before retrying.",
      "tools": ["get_refund_history"]
    }
  ],
  "reviews": [
    {
      "id": "customer-reply-review",
      "kind": "customer_reply_review",
      "owner": "support",
      "policy": "The customer reply is accurate, complete, and does not expose payment details."
    },
    {
      "id": "release-approval",
      "kind": "release_approval",
      "owner": "finance",
      "policy": "Finance approves the agent release.",
      "roles": ["finance"]
    }
  ]
}
